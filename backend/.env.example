# =====================================================
# Workout Hacker Backend — Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/workout_hacker?schema=public"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# --- OTP ---
OTP_EXPIRES_IN_MINUTES=10

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Workout Hacker <noreply@workouthacker.app>"

# --- AI / Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:4000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
